---
import Navbar from "../components/Navbar.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body id="top">
    <Navbar />
    <slot />
    <div class="do-gory">
      <a href="#top" aria-label="Przewiń na górę strony"><span class="do-gory__strzalka">↑</span>Do góry</a>
    </div>
    <footer class="site-footer">
      <div class="container">
        <p>Hydraulik 24 Warszawa &copy; {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --navy: #1b3252;
    --navy-dark: #142640;
    --bg: #f4f4f2;
    --card: #ffffff;
    --text: #262a30;
    --muted: #707880;
    --orange: #f7941e;
    --orange-hover: #e2830d;
    --green: #43a047;
    --dark-box: #1d1d1b;
    --star: #f6a723;
    --border: #e3e3df;
    --radius: 16px;
    --shadow: 0 2px 14px rgba(20, 30, 50, 0.08);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  body {
    font-family: "PT Sans", "Segoe UI", system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 17px;
    line-height: 1.6;
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px;
  }

  h1, h2, h3 {
    color: var(--navy);
    line-height: 1.25;
  }

  a {
    color: var(--navy);
  }

  .btn {
    display: inline-block;
    padding: 13px 30px;
    border-radius: 999px;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    border: 1px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .btn--primary {
    background: var(--orange);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--orange-hover);
  }

  .btn--ghost {
    background: #fff;
    color: var(--text);
    border-color: #c9ccd1;
  }

  .btn--ghost:hover {
    border-color: var(--navy);
  }

  section {
    padding: 48px 0;
  }

  .section-head {
    margin-bottom: 28px;
  }

  .section-head h2 {
    font-size: 30px;
  }

  .do-gory {
    text-align: center;
    margin: 6px 0 26px;
  }

  .do-gory a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 26px;
    border-radius: 999px;
    border: 1px solid #c9ccd1;
    background: #fff;
    color: var(--navy);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .do-gory a:hover {
    border-color: var(--navy);
  }

  .do-gory__strzalka {
    color: var(--orange);
    font-size: 18px;
    line-height: 1;
  }

  .site-footer {
    background: var(--navy);
    color: #cfd8e4;
    padding: 26px 0;
    margin-top: 40px;
  }

  .site-footer p {
    font-size: 16px;
  }

  @media (max-width: 640px) {
    body {
      font-size: 16px;
    }
    .section-head h2 {
      font-size: 24px;
    }
    section {
      padding: 36px 0;
    }
  }
</style>
