---
const links = [
  { href: "#uslugi", label: "Usługi" },
  { href: "#o-nas", label: "O nas" },
  { href: "#obszar-dzialania", label: "Obszar działania" },
];
---

<header class="nav-wrap">
  <div class="container">
    <nav class="navbar">
      <a href="/" class="navbar__brand">Hydraulik 24 Warszawa</a>
      <ul class="navbar__links">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-wrap {
    padding-top: 14px;
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    background: var(--navy);
    border-radius: var(--radius);
    padding: 14px 26px;
    box-shadow: var(--shadow);
  }

  .navbar__brand {
    color: #fff;
    font-weight: 700;
    font-size: 19px;
    text-decoration: none;
    white-space: nowrap;
  }

  .navbar__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 26px;
    list-style: none;
  }

  .navbar__links a {
    color: #fff;
    text-decoration: none;
    font-size: 16.5px;
  }

  .navbar__links a:hover {
    color: var(--orange);
  }

  @media (max-width: 760px) {
    .nav-wrap {
      padding-top: 12px;
    }
    .navbar {
      flex-direction: column;
      align-items: flex-start;
      padding: 14px 18px;
    }
    .navbar__links {
      justify-content: flex-start;
      gap: 4px 18px;
    }
  }
</style>
